<?xml version="1.0" encoding="utf-8"?>
<!-- The app's one screen: link this phone, check it can ring, test it, open iklipse. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:fillViewport="true"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:contentDescription="iklipse"
                android:src="@drawable/ikli" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="iklipse"
                    android:textColor="@color/ink"
                    android:textSize="24sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Ikli's calls ring on this phone"
                    android:textColor="@color/subtle"
                    android:textSize="14sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- A new version -->
        <LinearLayout
            android:id="@+id/update"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:background="@drawable/card"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="16dp"
            android:visibility="gone">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="A new version is ready"
                android:textColor="@color/ink"
                android:textSize="15sp" />

            <Button
                android:id="@+id/get_update"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:background="@drawable/btn_primary"
                android:paddingHorizontal="18dp"
                android:stateListAnimator="@null"
                android:text="Update"
                android:textAllCaps="false"
                android:textColor="#FFFFFF" />
        </LinearLayout>

        <!-- Linking -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:background="@drawable/card"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:id="@+id/linked"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Not linked yet"
                android:textColor="@color/ink"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/link_help"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:lineSpacingMultiplier="1.2"
                android:text="In iklipse, open Alerts > My phone and tap Link this phone. Or type the code it shows here."
                android:textColor="@color/muted"
                android:textSize="14sp" />

            <LinearLayout
                android:id="@+id/link_form"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:orientation="horizontal">

                <EditText
                    android:id="@+id/code"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:background="@drawable/field"
                    android:fontFamily="monospace"
                    android:hint="CODE"
                    android:importantForAutofill="no"
                    android:inputType="textCapCharacters|textNoSuggestions"
                    android:letterSpacing="0.15"
                    android:maxLength="8"
                    android:paddingHorizontal="14dp"
                    android:textColor="@color/ink"
                    android:textColorHint="@color/subtle"
                    android:textSize="17sp" />

                <Button
                    android:id="@+id/link"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:layout_marginStart="10dp"
                    android:background="@drawable/btn_primary"
                    android:paddingHorizontal="20dp"
                    android:stateListAnimator="@null"
                    android:text="Link"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF"
                    android:textSize="15sp" />
            </LinearLayout>

            <Button
                android:id="@+id/get_code"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/btn_soft"
                android:stateListAnimator="@null"
                android:text="Get a code in iklipse"
                android:textAllCaps="false"
                android:textColor="@color/ink"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/message"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:textColor="@color/accent"
                android:textSize="14sp"
                android:visibility="gone" />
        </LinearLayout>

        <!-- Can it ring -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/card"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Ready to ring"
                android:textColor="@color/ink"
                android:textSize="17sp"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/checks"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <Button
                android:id="@+id/test"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:layout_marginTop="14dp"
                android:background="@drawable/btn_soft"
                android:stateListAnimator="@null"
                android:text="Ring this phone"
                android:textAllCaps="false"
                android:textColor="@color/ink"
                android:textSize="15sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="It rings 5 seconds after you tap. Lock the phone to see the full call screen."
                android:textColor="@color/subtle"
                android:textSize="13sp" />
        </LinearLayout>

        <Button
            android:id="@+id/open"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="20dp"
            android:background="@drawable/btn_primary"
            android:stateListAnimator="@null"
            android:text="Open iklipse"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/version"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center"
            android:textColor="@color/subtle"
            android:textSize="12sp" />
    </LinearLayout>
</ScrollView>
