<?xml version="1.0" encoding="utf-8"?>
<!-- The web app's maskable icon, sized so the launcher's mask shows all of it. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/bg" />
    <foreground>
        <inset android:drawable="@drawable/ic_launcher_art" android:inset="16.7%" />
    </foreground>
</adaptive-icon>
