<Project Sdk="Microsoft.NET.Sdk">
  <!--
    iklipse for Windows: the web app in WebView2 (built into Windows 10 / 11),
    in the tray next to the clock. .NET Framework 4.8 ships with Windows, so the
    installer stays a few MB. Built and published by .github/workflows/desktop.yml.
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <LangVersion>latest</LangVersion>
    <AssemblyName>iklipse</AssemblyName>
    <RootNamespace>Iklipse</RootNamespace>
    <PlatformTarget>x64</PlatformTarget>
    <ApplicationIcon>iklipse.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- The build number on GitHub; the app compares it to find updates. -->
    <BuildCode Condition="'$(BuildCode)' == ''">1</BuildCode>
    <Version>1.0.$(BuildCode)</Version>
    <Product>iklipse</Product>
    <Company>iklipse</Company>
    <AssemblyTitle>iklipse</AssemblyTitle>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2792.45" />
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="System.Net.Http" />
    <Reference Include="System.Web.Extensions" />
  </ItemGroup>
</Project>
